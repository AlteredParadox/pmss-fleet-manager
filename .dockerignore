# Only what the Go build needs reaches the builder: sources, go.mod/go.sum,
# the embedded front-end, LICENSE and THIRD_PARTY_LICENSES.md (legal.go).
.git
.github
.claude
data
dist
bin
design
docs
pmss-fleet-manager
*.db
*.db-*
*.test
coverage.out
gpt_review_*.md
sonar-project.properties
node_modules
package.json
package-lock.json
# Local secrets never reach a (possibly remote) builder.
.env
.env.*
*.pem
*.key
.ssh
id_*
secret
.agents
.codex
.aws
.docker
.gnupg
.netrc
